# Supabase PostgreSQL connection string (Session Pooler recommended).
# Replace every placeholder with your own Supabase connection details.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Comma-separated frontend origins allowed to call this API.
# Add your deployed frontend origin when deploying.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
